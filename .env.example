# Zmienne srodowiskowe sterownika CO/CWU
# Skopiuj ten plik jako .env i uzupelnij. Plik .env nie trafia do gita.
# Format: NAZWA=wartosc   (cudzyslowy opcjonalne; komentarz tylko w osobnej linii)
# Pusta wartosc = wartosc domyslna z include/config.h
# UWAGA: to sa wartosci startowe. Po zapisaniu strony http://<IP>/config obowiazuja
# dane zapisane w sterowniku (Wi-Fi, Firebase, hasla, piny).

# --- Wi-Fi ---
WIFI_SSID=NazwaSieci
WIFI_PASSWORD=HasloSieci

# --- Firebase Realtime Database (te same dane co w starym sterowniku) ---
FIREBASE_API_KEY=
FIREBASE_DATABASE_URL=
# Opcjonalnie logowanie e-mailem. Puste = konto anonimowe (jak w starym sterowniku)
FIREBASE_USER_EMAIL=
FIREBASE_USER_PASSWORD=

# --- Panel WWW http://<IP>/panel ---
# Haslo puste = panel bez logowania (tylko w zaufanej sieci!)
WEB_USER=admin
WEB_PASSWORD=

# --- Aktualizacja przez Wi-Fi (OTA). Puste = OTA wylaczone ---
OTA_PASSWORD=

# --- Siec konfiguracyjna (wlacza sie sama bez Wi-Fi albo z menu) ---
# Haslo sieci Sterownik-CO-xxxx, min. 8 znakow.
# ZMIEN JE! Domyslne haslo jest publiczne, a strona konfiguracji w tej sieci
# nie pyta o haslo panelu (to droga odzyskania dostepu).
AP_PASSWORD=ZmienToHaslo

# --- Inne ---
DEVICE_HOSTNAME=sterownik-co
NTP_SERVER=pool.ntp.org
# Strefa czasowa POSIX (Polska z czasem letnim)
TZ_INFO=CET-1CEST,M3.5.0,M10.5.0/3
